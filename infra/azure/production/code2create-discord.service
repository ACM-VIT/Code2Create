[Unit]
Description=Code2Create Discord support bridge
Requires=docker.service
After=docker.service network-online.target code2create.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/code2create
ExecStartPre=/srv/code2create/render-discord-runtime-env.sh
ExecStart=/usr/bin/docker compose --file discord-compose.yml up --detach --remove-orphans
ExecStop=/usr/bin/docker compose --file discord-compose.yml down
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
