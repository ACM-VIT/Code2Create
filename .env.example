# Optional local override. `pnpm dev` supplies a stable localhost-only value
# when this is empty. Staging and production require their own random secret.
BETTER_AUTH_SECRET=

# Optional local Google sign-in. The localhost-only test identities work without
# these values. For a Google Web OAuth client, register this exact redirect URI:
# http://localhost:3211/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_SUPREME_EMAILS=

# Used by Convex-backed intake intelligence when provider fixtures are disabled.
OPENAI_API_KEY=

# Optional real outbound-call provider configuration. Local full-flow fixtures
# exercise the same delivery state machine without dialing a real phone.
OUTBOUND_CALL_REQUEST_SECRET=
OUTBOUND_CALL_EVENT_SECRET=
