# Optional local override. `pnpm dev` supplies a stable localhost-only value
# when this is empty. Staging and production require their own random secret.
BETTER_AUTH_SECRET=

# Optional local Google sign-in. The localhost-only test identities work without
# these values. For a Google Web OAuth client, register this exact redirect URI:
# http://localhost:3211/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIAL_SUPREME_EMAILS=

# Optional local external-participant email OTP. These are the same
# least-privilege Cloudflare Email Sending credentials used by event email.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=Code2Create <updates@example.org>
CLOUDFLARE_EMAIL_REPLY_TO=

# Used by Convex-backed intake intelligence when provider fixtures are disabled.
OPENAI_API_KEY=
# Optional local PostHog server telemetry. This is a project ingest token, not a
# personal API key. Convex and the intelligence Worker remain no-ops if absent.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
NOVELTY_GLOBAL_REQUESTS_PER_MINUTE=1800
# Separately paces durable saved/submitted indexing. It does not limit previews.
NOVELTY_INDEX_REQUESTS_PER_MINUTE=300

# Optional real outbound-call provider configuration. Local full-flow fixtures
# exercise the same delivery state machine without dialing a real phone.
OUTBOUND_CALL_REQUEST_SECRET=
OUTBOUND_CALL_EVENT_SECRET=
