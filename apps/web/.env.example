# Release environment template. Local development uses the tracked .env.development.
CLOUDFLARE_ENV=staging
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_EVENT_SLUG=code2create-7
VITE_DEPLOYMENT_ENVIRONMENT=staging
VITE_RELEASE_ID=replace-with-git-commit
VITE_SENTRY_DSN=

# Build-only source-map upload values. SENTRY_AUTH_TOKEN is a secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
