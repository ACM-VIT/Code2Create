{
  "name": "@code2create/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "badges:generate": "node --experimental-strip-types scripts/generateAttendanceBadges.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "node ../backend/scripts/release/webEnvironment.ts participant build && pnpm build && pnpm posthog:sourcemaps",
    "posthog:sourcemaps": "node ../../scripts/upload-posthog-sourcemaps.mjs dist code2create-participant",
    "cloudflare:build:staging": "CLOUDFLARE_ENV=staging VITE_CONVEX_URL=https://realtime-staging.c2c.sh VITE_CONVEX_SITE_URL=https://api-staging.c2c.sh VITE_EVENT_SLUG=code2create-7 VITE_DEPLOYMENT_ENVIRONMENT=staging VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm build:release",
    "cloudflare:deploy:staging": "CLOUDFLARE_ENV=staging VITE_DEPLOYMENT_ENVIRONMENT=staging VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm deploy:built",
    "cloudflare:build:production": "CLOUDFLARE_ENV=production VITE_DEPLOYMENT_ENVIRONMENT=production VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm build:release",
    "cloudflare:deploy:production": "CLOUDFLARE_ENV=production VITE_DEPLOYMENT_ENVIRONMENT=production VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm deploy:built",
    "deploy": "pnpm build:release && pnpm deploy:built",
    "deploy:built": "node ../backend/scripts/release/webEnvironment.ts participant deploy && node ../backend/scripts/release/deployCloudflareViteWorker.ts code2create-participant",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test scripts/generateAttendanceBadges.test.ts src/lib/errors.test.ts src/lib/googleAuthorization.test.ts src/lib/intakeCollaboration.test.ts src/lib/operations.test.ts src/lib/sessionDraft.test.ts src/lib/teamLeave.test.ts src/lib/time.test.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@code2create/backend": "workspace:*",
    "@code2create/client-observability": "workspace:*",
    "@code2create/domain": "workspace:*",
    "@code2create/web-auth": "workspace:*",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/presence": "0.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "~1.6.30",
    "convex": "^1.45.0",
    "gsap": "^3.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@webgpu/types": "^0.1.72",
    "oxlint": "^1.80.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
