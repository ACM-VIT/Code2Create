{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code2create-updates",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "code2create-updates-staging",
      "vars": {
        "UPDATE_CHANNEL": "staging",
      },
      "r2_buckets": [
        {
          "binding": "UPDATES",
          "bucket_name": "code2create-updates-staging",
        },
      ],
    },
    "production": {
      "name": "code2create-updates",
      "routes": [
        {
          "pattern": "updates.c2c.sh",
          "custom_domain": true,
        },
      ],
      "vars": {
        "UPDATE_CHANNEL": "production",
      },
      "r2_buckets": [
        {
          "binding": "UPDATES",
          "bucket_name": "code2create-updates",
        },
      ],
    },
  },
}
