{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "code2create-intelligence",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true, "traces": { "enabled": true } },
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueOperationsBriefAgent"] }
	],
	"env": {
		"staging": { "name": "code2create-intelligence-staging" },
		"production": { "name": "code2create-intelligence" }
	}
}
