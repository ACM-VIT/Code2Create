# Supply these values through the recovery operator's secret manager. Do not
# copy them into a deployed application or a committed .env file.
C2C_PRODUCTION_DEPLOYMENT=team-slug:project-slug:prod
C2C_PRODUCTION_CONVEX_DEPLOY_KEY=

# This must name a separate, disposable staging deployment. The rehearsal CLI
# rejects prod, production, dev, local, and the configured production target.
C2C_STAGING_DEPLOYMENT=team-slug:project-slug:staging
C2C_STAGING_CONVEX_DEPLOY_KEY=

# Separate backup/recovery IAM identity. The running application does not use it.
C2C_RECOVERY_S3_REGION=ap-south-1
C2C_RECOVERY_S3_BUCKET=
C2C_RECOVERY_S3_ACCESS_KEY_ID=
C2C_RECOVERY_S3_SECRET_ACCESS_KEY=
C2C_RECOVERY_S3_KMS_KEY_ID=
