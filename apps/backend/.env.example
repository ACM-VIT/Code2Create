# Set these on each Convex deployment with `pnpm exec convex env set`.
C2C_DEPLOYMENT_ENVIRONMENT=development
AUTH_SITE_URL=http://localhost:3211
PARTICIPANT_SITE_URL=http://localhost:5180
OPERATIONS_SITE_URL=http://localhost:5181
CONVEX_SITE_URL=http://127.0.0.1:3211
# Keep this stable for the lifetime of a deployment. Better Auth encrypts its
# signing key material with it; rotation requires a coordinated JWKS rotation.
BETTER_AUTH_SECRET=generate-a-random-secret
# Use one Google Web OAuth client per environment. Register the exact redirect
# URI `<CONVEX_SITE_URL>/api/auth/callback/google`. Local development therefore
# uses http://localhost:3211/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google emails allowed to create the event on an empty deployment.
INITIAL_SUPREME_EMAILS=
# Exact lowercase slug that the empty deployment is allowed to bootstrap.
INITIAL_EVENT_SLUG=code2create-7

OPENAI_API_KEY=
# Deployment-wide novelty preview budget. Set this from the verified OpenAI
# request limit and staging load result; the safe default is 1800 per minute.
NOVELTY_GLOBAL_REQUESTS_PER_MINUTE=1800
# Separately paces durable saved/submitted indexing. It does not limit previews.
NOVELTY_INDEX_REQUESTS_PER_MINUTE=300

# Flue intelligence Worker. Use a different random value for each HMAC domain
# and for each deployment environment.
INTELLIGENCE_WORKER_URL=https://code2create-intelligence-staging.example.workers.dev
INTELLIGENCE_INGRESS_SECRET=
INTELLIGENCE_CALLBACK_SECRET=
INTELLIGENCE_READ_SECRET=
INTELLIGENCE_STREAM_SECRET=

# GitHub App: user Starring read/write for participant authorization; repository
# Metadata read and Contents read for team evidence; push/installation webhooks.
# Register PARTICIPANT_SITE_URL/onboarding/github/callback as an exact callback.
# The participant step needs only the App client ID and client secret. Repository
# installation additionally needs the App ID, private key, and webhook secret.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Figma OAuth App. Register PARTICIPANT_SITE_URL/integrations/figma/callback exactly.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Private integration evidence and round exports. The application enforces the
# Mumbai region; the bucket must have versioning enabled and use the named KMS key.
ARTIFACT_S3_REGION=ap-south-1
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_KMS_KEY_ID=

# Named base64url-encoded 32-byte AES key for OAuth tokens and PKCE verifiers.
# Keep exactly the prior pair until the bounded rotation reports every live
# credential and unexpired pending/verifying intent on the current version.
PROVIDER_TOKEN_ENCRYPTION_KEY_VERSION=local-v1
PROVIDER_TOKEN_ENCRYPTION_KEY=
PROVIDER_TOKEN_PREVIOUS_ENCRYPTION_KEY_VERSION=
PROVIDER_TOKEN_PREVIOUS_ENCRYPTION_KEY=

# Native reviewer paging. Firebase sends Android FCM messages; APNs uses a
# token-signing key and selects sandbox/production from each registered device.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Participant status email through Cloudflare Email Sending. The callback secret
# must match the event-consumer Worker. Scope the API token to email sending only.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=Code2Create <updates@example.org>
CLOUDFLARE_EMAIL_REPLY_TO=
EMAIL_EVENT_CALLBACK_SECRET=

# Event-owned synthesized outbound calls. The request secret must match the
# Voice Worker request secret. The event secret must match its callback secret.
OUTBOUND_CALL_WORKER_URL=https://code2create-voice-staging.acmvit.workers.dev
OUTBOUND_CALL_REQUEST_SECRET=
OUTBOUND_CALL_EVENT_SECRET=

# Base64url-encoded 32-byte AES key. Keep the previous pair during wrapping-key rotation.
ATTENDANCE_WRAPPING_KEY_VERSION=local-v1
ATTENDANCE_WRAPPING_KEY=
ATTENDANCE_PREVIOUS_WRAPPING_KEY_VERSION=
ATTENDANCE_PREVIOUS_WRAPPING_KEY=
