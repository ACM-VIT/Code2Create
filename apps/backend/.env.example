# Set these on each Convex deployment with `pnpm exec convex env set`.
C2C_DEPLOYMENT_ENVIRONMENT=development
AUTH_SITE_URL=http://localhost:3211
PARTICIPANT_SITE_URL=http://localhost:5180
OPERATIONS_SITE_URL=http://localhost:5181
CONVEX_SITE_URL=http://127.0.0.1:3211
# Keep this stable for the lifetime of a deployment. Better Auth encrypts its
# signing key material with it; rotation requires a coordinated JWKS rotation.
BETTER_AUTH_SECRET=generate-a-random-secret
# Use one Google Web OAuth client per environment. Register the exact redirect
# URI `<CONVEX_SITE_URL>/api/auth/callback/google`. Local development therefore
# uses http://localhost:3211/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated verified Google emails allowed to create the event on an empty deployment.
INITIAL_SUPREME_EMAILS=
# Exact lowercase slug that the empty deployment is allowed to bootstrap.
INITIAL_EVENT_SLUG=code2create-7

OPENAI_API_KEY=
# PostHog server-side AI observability. Use the same project token and ingest
# host as the matching client surface. Prompts, outputs, and request bodies are
# never sent; only model, latency, usage, outcome, and trace metadata are sent.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://i.c2c.sh
C2C_RELEASE_ID=development
# Deployment-wide novelty preview budget. Set this from the verified OpenAI
# request limit and staging load result; the safe default is 1800 per minute.
NOVELTY_GLOBAL_REQUESTS_PER_MINUTE=1800
# Separately paces durable saved/submitted indexing. It does not limit previews.
NOVELTY_INDEX_REQUESTS_PER_MINUTE=300

# Participant phone verification through AWS End User Messaging SMS. The IAM
# credential needs only sms-voice:SendTextMessage in the configured region.
# New AWS accounts remain in the SMS sandbox until AWS approves production
# access. For Indian local routes, configure all three origination/DLT values
# and register this exact message template before sending participant traffic.
PHONE_VERIFICATION_HMAC_SECRET=
PHONE_VERIFICATION_MESSAGE_TEMPLATE=Your Code2Create verification code is {{code}}. It expires in 10 minutes. Do not share it.
SMS_AWS_REGION=ap-south-1
SMS_AWS_ACCESS_KEY_ID=
SMS_AWS_SECRET_ACCESS_KEY=
SMS_AWS_SESSION_TOKEN=
SMS_AWS_ORIGINATION_IDENTITY=
SMS_AWS_CONFIGURATION_SET=
SMS_AWS_ENTITY_ID=
SMS_AWS_TEMPLATE_ID=

# Flue intelligence Worker. Use a different random value for each HMAC domain
# and for each deployment environment.
INTELLIGENCE_WORKER_URL=https://code2create-intelligence-staging.example.workers.dev
INTELLIGENCE_INGRESS_SECRET=
INTELLIGENCE_CALLBACK_SECRET=
INTELLIGENCE_READ_SECRET=
INTELLIGENCE_STREAM_SECRET=

# Classic GitHub OAuth App for the participant SGLang step. Register
# PARTICIPANT_SITE_URL/onboarding/github/callback as its exact callback. The
# authorization requests only public_repo, stars SGLang, and then revokes itself.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for team repository evidence: Metadata read, Contents read, and
# push/installation webhooks. Keep these credentials separate from the OAuth App.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Figma OAuth App. Register PARTICIPANT_SITE_URL/integrations/figma/callback exactly.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Private integration evidence and round exports. The application enforces the
# Mumbai region; the bucket must have versioning enabled and use the named KMS key.
ARTIFACT_S3_REGION=ap-south-1
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_KMS_KEY_ID=

# Public photo gallery. Separate R2 buckets and bucket-scoped tokens per environment.
# Enable Cloudflare Image Transformations and caching on this custom domain.
PHOTO_R2_ACCOUNT_ID=
PHOTO_R2_ACCESS_KEY_ID=
PHOTO_R2_SECRET_ACCESS_KEY=
PHOTO_R2_BUCKET=
PHOTO_PUBLIC_ORIGIN=

# Named base64url-encoded 32-byte AES key for OAuth tokens and PKCE verifiers.
# Keep exactly the prior pair until the bounded rotation reports every live
# credential and unexpired pending/verifying intent on the current version.
PROVIDER_TOKEN_ENCRYPTION_KEY_VERSION=local-v1
PROVIDER_TOKEN_ENCRYPTION_KEY=
PROVIDER_TOKEN_PREVIOUS_ENCRYPTION_KEY_VERSION=
PROVIDER_TOKEN_PREVIOUS_ENCRYPTION_KEY=

# Native reviewer paging. Firebase sends Android FCM messages; APNs uses a
# token-signing key and selects sandbox/production from each registered device.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# External-participant sign-in codes and participant status email are sent through
# the event-owned email Worker. The ingress secret must match the Worker and contain
# at least 32 bytes. Choose one configured Worker provider for authentication email;
# participant-status email uses the provider pinned in its communications policy.
EMAIL_SERVICE_URL=http://localhost:8793
EMAIL_SEND_INGRESS_SECRET=
AUTHENTICATION_EMAIL_PROVIDER=aws_ses
EMAIL_EVENT_CALLBACK_SECRET=

# External-participant event passes. Google Wallet uses a service account
# authorized in the Google Wallet console. Apple Wallet requires a Pass Type ID
# certificate, its private key, and Apple's WWDR certificate, each base64 encoded.
# Keep the download signing secret deployment-specific and at least 32 characters.
# A missing, partial, or failing wallet provider hides only that wallet action.
# The inline QR email remains independently deliverable.
WALLET_DOWNLOAD_SIGNING_SECRET=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=
APPLE_WALLET_SIGNER_CERTIFICATE_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=

# Event-owned synthesized outbound calls. The request secret must match the
# Voice Worker request secret. The event secret must match its callback secret.
OUTBOUND_CALL_WORKER_URL=https://code2create-voice-staging.acmvit.workers.dev
OUTBOUND_CALL_REQUEST_SECRET=
OUTBOUND_CALL_EVENT_SECRET=

# Base64url-encoded 32-byte AES key. Keep the previous pair during wrapping-key rotation.
ATTENDANCE_WRAPPING_KEY_VERSION=local-v1
ATTENDANCE_WRAPPING_KEY=
ATTENDANCE_PREVIOUS_WRAPPING_KEY_VERSION=
ATTENDANCE_PREVIOUS_WRAPPING_KEY=
