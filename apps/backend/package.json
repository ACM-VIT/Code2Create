{
  "name": "@code2create/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    }
  },
  "scripts": {
    "generate:handbook": "node ../../scripts/generate-handbook.mjs",
    "dev": "pnpm generate:handbook && convex dev",
    "dev:once": "pnpm generate:handbook && convex dev --once",
    "recovery:backup": "node scripts/recovery/backup.ts",
    "recovery:rehearse": "node scripts/recovery/rehearse.ts",
    "test": "pnpm test:recovery && pnpm test:release-environment && pnpm test:release-providers && pnpm test:release-fixtures && pnpm test:providers && pnpm test:identity && pnpm test:permissions && pnpm test:permission-writes && pnpm test:permission-lifecycle && pnpm test:bootstrap && pnpm test:event-lifecycle && pnpm test:intake-configuration && pnpm test:participant-policy && pnpm test:admission-configuration && pnpm test:admission-information && pnpm test:novelty && pnpm test:communications && pnpm test:attendance-stations && pnpm test:attendance-scan && pnpm test:attendance-sessions && pnpm test:attendance-credentials && pnpm test:attendance-replay && pnpm test:admission-routing && pnpm test:offers && pnpm test:intelligence && pnpm test:push && pnpm test:github-repositories && pnpm test:figma-evidence && pnpm test:figma-comparison && pnpm test:queue-estimate && pnpm test:emergency-pack && pnpm test:operations-health && pnpm test:support && pnpm test:rehearsal && pnpm test:operations-attention && pnpm test:panel-membership && pnpm test:demo-seed",
    "test:recovery": "node --test scripts/recovery/recovery.test.ts",
    "test:release-environment": "node --test scripts/release/webEnvironment.test.ts",
    "test:release-providers": "node --test scripts/release/providerEnvironment.test.ts",
    "test:release-fixtures": "node --test scripts/release/browserFixtureEnvironment.test.ts && vitest run convex/releaseVerification.test.ts",
    "browser-fixtures:check:staging": "node scripts/release/checkBrowserFixtures.ts",
    "providers:check:staging": "node scripts/release/liveProviderChecks.ts",
    "test:providers": "vitest run convex/providerContracts.test.ts convex/lib/cloudflareEmailSending.test.ts",
    "test:identity": "vitest run convex/lib/identity.test.ts",
    "test:permissions": "vitest run convex/permissionDelegation.test.ts",
    "test:permission-writes": "vitest run convex/permissionGrantWrites.test.ts",
    "test:permission-lifecycle": "vitest run convex/permissionGrantLifecycle.test.ts",
    "test:bootstrap": "vitest run convex/systemBootstrap.test.ts",
    "test:event-lifecycle": "vitest run convex/eventLifecycle.test.ts",
    "test:intake-configuration": "vitest run convex/intakePolicyConfiguration.test.ts convex/trackCatalogConfiguration.test.ts convex/eventPhaseConfiguration.test.ts convex/projectCheckpointLifecycle.test.ts",
    "test:participant-policy": "vitest run convex/participantPolicyLifecycle.test.ts convex/participantOnboardingLifecycle.test.ts",
    "test:admission-configuration": "vitest run convex/admissionPolicyConfiguration.test.ts",
    "test:admission-information": "vitest run convex/admissionInformationLifecycle.test.ts",
    "test:novelty": "vitest run convex/noveltyLifecycle.test.ts convex/lib/novelty.test.ts",
    "test:communications": "vitest run convex/communicationsPolicyLifecycle.test.ts",
    "test:attendance-stations": "vitest run convex/attendanceStationLifecycle.test.ts",
    "test:attendance-scan": "vitest run convex/attendanceScanTransition.test.ts",
    "test:attendance-sessions": "vitest run convex/attendanceSessionLifecycle.test.ts",
    "test:attendance-credentials": "vitest run convex/attendanceCredentialLifecycle.test.ts convex/attendanceBadgeLifecycle.test.ts convex/attendancePortalQrLifecycle.test.ts convex/venueCheckInLifecycle.test.ts",
    "test:attendance-replay": "vitest run convex/lib/attendanceOfflineReplay.test.ts",
    "test:admission-routing": "vitest run convex/admissionReviewAssignments.test.ts",
    "test:offers": "vitest run convex/admissionOffers.test.ts",
    "test:intelligence": "vitest run convex/operationsIntelligence.test.ts convex/operationsIntelligenceAutomation.test.ts",
    "test:push": "node --test convex/lib/pushTokens.test.ts",
    "test:github-repositories": "vitest run convex/githubRepositoryOrder.test.ts convex/githubTeamMetrics.test.ts",
    "test:figma-evidence": "vitest run convex/figmaTeamMetrics.test.ts && node --test convex/lib/figmaEvidenceBrowser.test.ts",
    "test:figma-comparison": "node --test convex/lib/figmaCheckpointComparison.test.ts",
    "test:queue-estimate": "node --test convex/lib/queueEstimate.test.ts",
    "test:emergency-pack": "node --test convex/lib/emergencyPack.test.ts",
    "test:operations-health": "node --test convex/lib/operationsHealth.test.ts",
    "test:support": "node --test convex/lib/supportCases.test.ts",
    "test:rehearsal": "node --test convex/lib/rehearsal.test.ts",
    "test:operations-attention": "node --test convex/lib/operationsAttention.test.ts",
    "test:panel-membership": "vitest run convex/reviewPanelMembership.test.ts",
    "test:demo-seed": "vitest run convex/localDemoSeed.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@better-auth/core": "1.6.25",
    "@better-auth/expo": "~1.6.25",
    "@code2create/domain": "workspace:*",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/workpool": "^0.4.9",
    "@noble/hashes": "^2.2.0",
    "better-auth": "~1.6.25",
    "convex": "^1.43.0",
    "firebase-admin": "^14.2.0",
    "jose": "^6.2.8",
    "octokit": "^5.0.5",
    "openai": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "convex-test": "0.0.55",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  }
}
