{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code2create-email",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OutboundEmailDelivery"] }],
  "env": {
    "staging": {
      "name": "code2create-email-staging",
      "durable_objects": { "bindings": [{ "name": "OUTBOUND_EMAILS", "class_name": "OutboundEmailDelivery" }] },
      "queues": {
        "consumers": [
          {
            "queue": "code2create-email-events-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "code2create-email-events-staging-dlq",
          },
        ],
      },
    },
    "production": {
      "name": "code2create-email",
      "durable_objects": { "bindings": [{ "name": "OUTBOUND_EMAILS", "class_name": "OutboundEmailDelivery" }] },
      "routes": [
        {
          "pattern": "email.c2c.sh",
          "custom_domain": true,
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "code2create-email-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "code2create-email-events-dlq",
          },
        ],
      },
    },
  },
}
