{
  "name": "@code2create/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --env staging --port 8793 --inspector-port 9240",
    "build": "pnpm build:staging",
    "build:staging": "wrangler deploy --config wrangler.jsonc --env staging --dry-run",
    "build:production": "wrangler deploy --config wrangler.jsonc --env production --dry-run",
    "cloudflare:build:staging": "pnpm build:staging",
    "cloudflare:deploy:staging": "pnpm deploy:staging",
    "cloudflare:build:production": "pnpm build:production",
    "cloudflare:deploy:production": "pnpm deploy:production",
    "deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging --strict",
    "deploy:production": "wrangler deploy --config wrangler.jsonc --env production --strict",
    "queue:create:staging": "pnpm run queue:create:staging:dlq && pnpm run queue:create:staging:events",
    "queue:create:staging:dlq": "wrangler queues create code2create-email-events-staging-dlq --config wrangler.jsonc",
    "queue:create:staging:events": "wrangler queues create code2create-email-events-staging --config wrangler.jsonc",
    "queue:create:production": "pnpm run queue:create:production:dlq && pnpm run queue:create:production:events",
    "queue:create:production:dlq": "wrangler queues create code2create-email-events-dlq --config wrangler.jsonc",
    "queue:create:production:events": "wrangler queues create code2create-email-events --config wrangler.jsonc",
    "subscription:list:staging": "wrangler queues subscription list code2create-email-events-staging --json --config wrangler.jsonc",
    "subscription:list:production": "wrangler queues subscription list code2create-email-events --json --config wrangler.jsonc",
    "lint": "oxlint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code2create/domain": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}
