{
  "name": "@code2create/ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "node ../backend/scripts/release/webEnvironment.ts operations build && pnpm build && pnpm posthog:sourcemaps",
    "posthog:sourcemaps": "node ../../scripts/upload-posthog-sourcemaps.mjs dist code2create-operations",
    "cloudflare:build:staging": "CLOUDFLARE_ENV=staging VITE_DEPLOYMENT_ENVIRONMENT=staging VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm build:release",
    "cloudflare:deploy:staging": "CLOUDFLARE_ENV=staging VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm deploy:built",
    "cloudflare:build:production": "CLOUDFLARE_ENV=production VITE_DEPLOYMENT_ENVIRONMENT=production VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm build:release",
    "cloudflare:deploy:production": "CLOUDFLARE_ENV=production VITE_RELEASE_ID=$WORKERS_CI_COMMIT_SHA pnpm deploy:built",
    "deploy": "pnpm build:release && pnpm deploy:built",
    "deploy:built": "node ../backend/scripts/release/webEnvironment.ts operations deploy && node ../backend/scripts/release/deployCloudflareViteWorker.ts code2create-operations",
    "lint": "oxlint",
    "test": "node --experimental-strip-types --test src/components/intelligence/intelligenceUiContract.test.ts src/components/intelligence/liveAgentProjection.test.ts src/lib/errors.test.ts src/lib/intelligenceConversation.test.ts src/lib/intelligenceStream.test.ts src/lib/operations.test.ts src/lib/operationsAutonomyPresentation.test.ts src/lib/operationsBrief.test.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@code2create/backend": "workspace:*",
    "@code2create/client-observability": "workspace:*",
    "@code2create/domain": "workspace:*",
    "@code2create/web-auth": "workspace:*",
    "@convex-dev/better-auth": "^0.12.5",
    "@date-fns/tz": "^1.5.0",
    "@flue/react": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "~1.6.25",
    "convex": "^1.43.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  }
}
