  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config:check": "expo config --type public",
    "export:check": "expo export --platform all --output-dir dist --clear",
    "native:android:check": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew app:compileDebugKotlin --no-daemon",
    "build:android:staging": "node scripts/nativeBuild.ts android staging",
    "build:android:production": "node scripts/nativeBuild.ts android production",
    "build:ios:staging": "node scripts/nativeBuild.ts ios staging",
    "build:ios:production": "node scripts/nativeBuild.ts ios production",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
