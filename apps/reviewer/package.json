{
  "name": "@code2create/reviewer",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config:check": "expo config --type public",
    "export:check": "node scripts/export-check.mjs",
    "native:android:check": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew app:compileDebugKotlin --no-daemon",
    "build:android:staging": "node scripts/nativeBuild.ts android staging",
    "build:android:production": "node scripts/nativeBuild.ts android production",
    "build:ios:staging": "node scripts/nativeBuild.ts ios staging",
    "build:ios:production": "node scripts/nativeBuild.ts ios production",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "~1.6.30",
    "@code2create/backend": "workspace:*",
    "@code2create/client-observability": "workspace:*",
    "@code2create/domain": "workspace:*",
    "@convex-dev/better-auth": "^0.12.5",
    "@expo/ui": "~57.0.14",
    "@lodev09/react-native-true-sheet": "^3.11.12",
    "@posthog/react-native-plugin": "^2.5.0",
    "better-auth": "~1.6.30",
    "convex": "^1.45.0",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-intent-launcher": "^57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.66.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  }
}
