# These localhost values target an iOS simulator. An Android emulator uses
# 10.0.2.2, while a physical phone uses this computer's private LAN address.
EXPO_PUBLIC_CONVEX_URL=http://localhost:3210
EXPO_PUBLIC_CONVEX_SITE_URL=http://localhost:3211
EXPO_PUBLIC_EVENT_SLUG=code2create-7
EXPO_PUBLIC_APP_BUILD=1
EXPO_PUBLIC_APNS_ENVIRONMENT=development
EXPO_PUBLIC_DEPLOYMENT_ENVIRONMENT=development
EXPO_PUBLIC_RELEASE_ID=local
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_HmlqIgClccJHqUbYVZSCUsD41yEmLlOOeSrj5tZPo7j
EXPO_PUBLIC_POSTHOG_HOST=https://i.c2c.sh

# The iOS simulator can reach the local Worker directly. For a physical phone, use this
# computer's private LAN address. Staging and production must use their HTTPS Worker URL.
C2C_UPDATES_URL=http://127.0.0.1:8792/manifest
C2C_IOS_BUNDLE_IDENTIFIER=
C2C_IOS_PROVISIONING_PROFILE_SPECIFIER=
C2C_ANDROID_PACKAGE=
C2C_IOS_TEAM_ID=
C2C_ANDROID_GOOGLE_SERVICES_FILE=

# Local app-store signing. Keep credentials out of source control.
C2C_ANDROID_KEYSTORE_PATH=
C2C_ANDROID_KEYSTORE_PASSWORD=
C2C_ANDROID_KEY_ALIAS=
C2C_ANDROID_KEY_PASSWORD=
C2C_IOS_EXPORT_METHOD=development

# Optional local source-map and native-symbol upload values. Set all three for a
# release build, or leave all three unset to build without uploading symbols.
# POSTHOG_CLI_API_KEY is a secret.
POSTHOG_CLI_HOST=https://eu.posthog.com
POSTHOG_CLI_PROJECT_ID=108327
POSTHOG_CLI_API_KEY=
