{
  "name": "@code2create/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --env staging --port 8794 --inspector-port 9241",
    "build": "pnpm build:staging",
    "build:staging": "wrangler deploy --config wrangler.jsonc --env staging --dry-run",
    "build:production": "wrangler deploy --config wrangler.jsonc --env production --dry-run",
    "cloudflare:build:staging": "pnpm build:staging",
    "cloudflare:deploy:staging": "pnpm deploy:staging",
    "cloudflare:build:production": "pnpm build:production",
    "cloudflare:deploy:production": "pnpm deploy:production",
    "deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging --strict",
    "deploy:production": "wrangler deploy --config wrangler.jsonc --env production --strict",
    "lint": "oxlint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@code2create/domain": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "oxlint": "^1.80.0",
    "typescript": "~7.0.2",
    "vitest": "4.1.12",
    "wrangler": "^4.127.1"
  }
}
